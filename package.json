{
  "name": "personal_assistant",
  "version": "1.0.0",
  "description": "Local personal assistant that writes and loads its own tools",
  "main": "dist/index.js",
  "bin": {
    "assistant": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "npx tsx src/server.ts",
    "dev": "npx tsx --watch --ignore ./sessions src/server.ts",
    "test": "npx tsx --test --test-concurrency=1 tests/*.test.ts"
  },
  "keywords": [
    "ai",
    "agent",
    "strands",
    "personal-assistant"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@chroma-core/default-embed": "^0.1.9",
    "@strands-agents/sdk": "^1.7.0",
    "chromadb": "^3.5.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "neo4j-driver": "^6.2.0",
    "openai": "^6.45.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.0",
    "typescript": "^6.0.3"
  }
}
