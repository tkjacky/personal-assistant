# Copy this file to .env and fill in the values you use.
# .env is gitignored. Do not put real keys or a home address in this file.

# Docker Model Runner (OpenAI-compatible endpoint)
DMR_BASE_URL=http://localhost:12434/v1
DMR_MODEL_ID=huggingface.co/google/gemma-4-12b-it-qat-q4_0-gguf

# Web server
PORT=3000
# Browser speech playback. Set to false to disable.
AUDIO_ENABLED=true

# Web search via Tavily (https://tavily.com). Leave the key empty to skip search.
WEB_SEARCH_ENABLED=true
TAVILY_API_KEY=

# Injected into the system prompt. Leave blank to use the code defaults.
USER_NAME=
USER_LOCATION=

# Model context and conversation snapshot id
CONTEXT_WINDOW_LIMIT=32768
SESSION_ID=default

# ChromaDB (started by docker compose)
CHROMA_HOST=localhost
CHROMA_PORT=8100

# Neo4j Bolt URL (started by docker compose)
NEO4J_URL=bolt://localhost:7687

# Panasonic VIERA. Leave TV_IP blank if you do not use tv_control.
TV_IP=
TV_PORT=55000

# Tool timeout, retry, and circuit breaker. See src/tool-resilience.ts for defaults.
# TOOL_TIMEOUT_MS=6000
# TOOL_MAX_RETRIES=1
# TOOL_BREAKER_ENABLED=true
# TOOL_RESILIENCE_STRICT=false
